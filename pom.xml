<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>com.bank</groupId>
    <artifactId>bank-core-platform</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>bank-core-platform</name>
    <description>Parent project for the Banking Core Platform</description>

    <modules>
        <module>bank-common</module>
        <module>bank-user-service</module>
        <module>bank-account-service</module>
        <module>bank-transaction-service</module>
        <module>bank-app</module>
        <module>bank-security-service</module>
        <module>bank-ledger-service</module>
        <module>bank-admin-service</module>
        <module>bank-notification-service</module>


        <!--


        <module>bank-reporting-service</module>

        <module>bank-api-gateway</module>
        <module>bank-config-server</module>
        <module>bank-discovery-server</module>
        -->
    </modules>

    <!-- ─────────────────────────────────────────────────────────────────
         Properties
         java.version is read by spring-boot-starter-parent to set the
         compiler source/target — no need to repeat maven.compiler.* in
         ANY child module.
         Versions for libraries NOT in Spring Boot's BOM (lombok, mapstruct)
         live here so every module/plugin references the SAME version
         through ${property} — this is the single source of truth.
    ───────────────────────────────────────────────────────────────────── -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lombok.version>1.18.30</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <!-- ─────────────────────────────────────────────────────────────────
         Dependency Management — versions ONLY. Nothing is added to any
         module automatically. Each child still declares what it needs
         in its own <dependencies> block; it just omits <version> for
         everything listed here.
    ───────────────────────────────────────────────────────────────────── -->
    <dependencyManagement>
        <dependencies>

            <!-- Internal modules — version always in sync with project.version -->
            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-user-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-account-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-transaction-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-security-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-ledger-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-admin-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.bank</groupId>
                <artifactId>bank-notification-service</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>

            <!-- Third-party libraries NOT covered by Spring Boot's BOM -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ─────────────────────────────────────────────────────────────────
         Plugin Management — centralises the annotation-processor setup
         for Lombok + MapStruct. Any child module using either inherits
         this automatically — no <build> block needed in child POMs.
         Order matters: Lombok MUST run before MapStruct so MapStruct's
         generated code can see Lombok's generated getters/setters.
    ───────────────────────────────────────────────────────────────────── -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>